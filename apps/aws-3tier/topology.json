{
  "name": "aws-3tier",
  "title": "AWS 3-Tier Enterprise Cloud Architecture",
  "description": "Production-grade 3-Tier AWS Architecture featuring Public Ingress (WAF v2, ALB), Dual-AZ EC2 Web Tier, Microservice App Tier, Amazon RDS Aurora PostgreSQL, and S3 Lakehouse.",
  "nodes": [
    { "id": "igw", "label": "Internet Gateway", "kind": "internet_gateway", "role": "gateway", "x": 500, "y": 70 },
    { "id": "ws1", "label": "Admin Console (WS-01)", "kind": "workstation", "role": "admin", "x": 220, "y": 70 },
    { "id": "iot1", "label": "Smart Sensor (IoT-01)", "kind": "iot", "role": "sensor", "x": 880, "y": 70 },
    { "id": "waf", "label": "AWS WAF v2", "kind": "firewall", "role": "security", "x": 500, "y": 180 },
    { "id": "iot-gw", "label": "AWS IoT Core GW", "kind": "distribution_switch", "role": "iot_gw", "x": 880, "y": 180 },
    { "id": "alb", "label": "App Load Balancer (ALB)", "kind": "distribution_switch", "role": "alb", "x": 500, "y": 295 },
    { "id": "web1", "label": "Web Srv 1 (AZ-1a)", "kind": "server", "role": "web", "x": 380, "y": 420 },
    { "id": "web2", "label": "Web Srv 2 (AZ-1b)", "kind": "server", "role": "web", "x": 620, "y": 420 },
    { "id": "app1", "label": "Order Service (app1)", "kind": "server", "role": "app", "x": 380, "y": 550 },
    { "id": "app2", "label": "Auth Service (app2)", "kind": "server", "role": "app", "x": 620, "y": 550 },
    { "id": "db1", "label": "Aurora RDS (db1)", "kind": "server", "role": "db", "x": 420, "y": 675 },
    { "id": "s3", "label": "Amazon S3 Lakehouse", "kind": "server", "role": "storage", "x": 760, "y": 675 }
  ],
  "links": [
    { "id": "igw-waf", "src": "igw", "dst": "waf", "bandwidth_mbps": 10000.0, "base_latency_ms": 0.5, "kind": "wan" },
    { "id": "waf-alb", "src": "waf", "dst": "alb", "bandwidth_mbps": 10000.0, "base_latency_ms": 0.3, "kind": "ethernet" },
    { "id": "alb-web1", "src": "alb", "dst": "web1", "bandwidth_mbps": 5000.0, "base_latency_ms": 0.4, "kind": "ethernet" },
    { "id": "alb-web2", "src": "alb", "dst": "web2", "bandwidth_mbps": 5000.0, "base_latency_ms": 0.4, "kind": "ethernet" },
    { "id": "web1-app1", "src": "web1", "dst": "app1", "bandwidth_mbps": 2500.0, "base_latency_ms": 0.3, "kind": "ethernet" },
    { "id": "web1-app2", "src": "web1", "dst": "app2", "bandwidth_mbps": 2500.0, "base_latency_ms": 0.3, "kind": "ethernet" },
    { "id": "web2-app1", "src": "web2", "dst": "app1", "bandwidth_mbps": 2500.0, "base_latency_ms": 0.3, "kind": "ethernet" },
    { "id": "web2-app2", "src": "web2", "dst": "app2", "bandwidth_mbps": 2500.0, "base_latency_ms": 0.3, "kind": "ethernet" },
    { "id": "app1-db1", "src": "app1", "dst": "db1", "bandwidth_mbps": 2000.0, "base_latency_ms": 0.2, "kind": "ethernet" },
    { "id": "app2-db1", "src": "app2", "dst": "db1", "bandwidth_mbps": 2000.0, "base_latency_ms": 0.2, "kind": "ethernet" },
    { "id": "app1-s3", "src": "app1", "dst": "s3", "bandwidth_mbps": 2000.0, "base_latency_ms": 0.8, "kind": "ethernet" },
    { "id": "app2-s3", "src": "app2", "dst": "s3", "bandwidth_mbps": 2000.0, "base_latency_ms": 0.8, "kind": "ethernet" },
    { "id": "iot1-iot-gw", "src": "iot1", "dst": "iot-gw", "bandwidth_mbps": 100.0, "base_latency_ms": 1.5, "kind": "ethernet" },
    { "id": "iot-gw-s3", "src": "iot-gw", "dst": "s3", "bandwidth_mbps": 1000.0, "base_latency_ms": 1.0, "kind": "ethernet" },
    { "id": "ws1-igw", "src": "ws1", "dst": "igw", "bandwidth_mbps": 500.0, "base_latency_ms": 1.0, "kind": "ethernet" }
  ],
  "tiers": [
    {
      "id": "ingress",
      "name": "Public Ingress Subnet",
      "cidr": "10.0.1.0/24",
      "nodes": ["igw", "waf", "alb"],
      "box": { "x1": 340, "y1": 40, "x2": 660, "y2": 335 }
    },
    {
      "id": "web",
      "name": "Web Tier ASG (Public Subnet)",
      "cidr": "10.0.2.0/24",
      "nodes": ["web1", "web2"],
      "box": { "x1": 270, "y1": 375, "x2": 730, "y2": 465 }
    },
    {
      "id": "app",
      "name": "Application Tier (Private Subnet)",
      "cidr": "10.0.3.0/24",
      "nodes": ["app1", "app2"],
      "box": { "x1": 270, "y1": 505, "x2": 730, "y2": 595 }
    },
    {
      "id": "data",
      "name": "Database & Storage Tier (Isolated)",
      "cidr": "10.0.4.0/24",
      "nodes": ["db1", "s3"],
      "box": { "x1": 310, "y1": 630, "x2": 870, "y2": 725 }
    },
    {
      "id": "edge",
      "name": "Edge Devices & IoT Subnet",
      "cidr": "10.0.5.0/24",
      "nodes": ["ws1", "iot1", "iot-gw"],
      "box": { "x1": 770, "y1": 40, "x2": 990, "y2": 225 }
    }
  ]
}
